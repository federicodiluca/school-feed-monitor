# Copia in .env e personalizza. .env è ignorato da git: MAI committare credenziali.

# --- Email: backend di invio ---------------------------------------------
# smtp   = server SMTP (es. Brevo: smtp-relay.brevo.com, porta 587, STARTTLS)
# resend = API Resend (RESEND_API_KEY)
# none   = disabilitato (le email vengono solo loggate)
EMAIL_BACKEND=none
EMAIL_FROM="School Feed Monitor <noreply@tuodominio.it>"
# EMAIL_REPLY_TO=tu@tuodominio.it

# SMTP (Brevo: "SMTP & API" > SMTP nel pannello; SMTP_USER è la login, SMTP_PASSWORD la chiave SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMTP_TLS: starttls (default) | ssl | none
SMTP_TLS=starttls

# Resend (alternativa)
# RESEND_API_KEY=re_xxxxxxxx

# --- Web -------------------------------------------------------------------
# URL pubblico dell'app: usato nei link "gestisci preferenze" delle email
# APP_BASE_URL=https://schoolfeedmonitor.tuodominio.it

# --- Watchdog (avvisi all'amministratore) -----------------------------------
# ADMIN_TELEGRAM_ID=123456789
# ADMIN_EMAIL=tu@tuodominio.it
# WATCHDOG_SOURCE_FAILURES=3          # letture fallite consecutive prima dell'avviso
# WATCHDOG_SOURCE_SILENCE_HOURS=72    # ore senza notizie nuove prima dell'avviso
# WATCHDOG_JOB_STALE_MINUTES=30       # default: 3 x polling_minutes
# Ping a un monitor esterno (es. https://healthchecks.io, gratuito) a ogni fetch riuscito:
# HEALTHCHECK_PING_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Web (Flask) -------------------------------------------------------------
# Chiave per firmare i cookie di sessione: genera con  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# FLASK_DEBUG=1
# WEB_HOST=127.0.0.1
# WEB_PORT=5000
# Username del bot (senza @): usato per il link "apri il bot" nella pagina preferenze
# TELEGRAM_BOT_USERNAME=IlTuoBot
# Accedi con Google (opzionale): crea un "OAuth client ID" (Web application) nella Google Cloud Console
# con redirect URI  <APP_BASE_URL>/accedi/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
