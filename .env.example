# Copia in .env e personalizza. .env è ignorato da git: MAI committare credenziali.

# --- Bot Telegram ------------------------------------------------------------
# Il token sta in config.json (anch'esso ignorato da git). Qui serve solo l'username
# del bot, senza @: finisce nei link "apri il bot e configura" del sito.
# TELEGRAM_BOT_USERNAME=IlTuoBot

# --- Sito --------------------------------------------------------------------
# URL pubblico del sito: canonical, sitemap, link assoluti.
# Su GitHub Pages è https://<utente>.github.io/<repo>
# APP_BASE_URL=https://federicodiluca.github.io/school-feed-monitor
# SITE_BASE_URL=https://federicodiluca.github.io/school-feed-monitor

# Chiave per firmare il cookie di sessione (serve solo al token CSRF del sito Flask):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# FLASK_DEBUG=1
# WEB_HOST=127.0.0.1
# WEB_PORT=5000

# Email pubblica di contatto e del titolare del trattamento (Chi siamo e privacy)
# CONTACT_EMAIL=schoolfeedmonitor@gmail.com

# --- Pubblicazione su GitHub Pages (scripts/publish_site.sh) ------------------
# SITE_OUT=data/site
# SITE_REMOTE=origin
# Come generare il sito: se il progetto gira in Docker, falla fare al container
# SITE_BUILD_CMD=docker compose run --rm -T bot python -m scripts.build_site --out /usr/src/app/data/site

# --- Watchdog (avvisi all'amministratore, via Telegram) ----------------------
# ADMIN_TELEGRAM_ID=123456789
# WATCHDOG_SOURCE_FAILURES=3          # letture fallite consecutive prima dell'avviso
# WATCHDOG_SOURCE_SILENCE_HOURS=72    # ore senza notizie nuove prima dell'avviso
# WATCHDOG_JOB_STALE_MINUTES=30       # default: 3 x polling_minutes
# Ping a un monitor esterno (es. https://healthchecks.io, gratuito) a ogni fetch riuscito:
# HEALTHCHECK_PING_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
